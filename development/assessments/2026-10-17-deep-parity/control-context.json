  "payloads": {
    "MSP88": "U8type,U8band,U8channel,U8powerIndex,U8pit,U16LEfrequency,U8ready,U8lowPowerDisarm,skip2BpitFrequency,U8tableAvailable,U8bandCount,U8channelCount,U8powerCount. Original supports table/cache branch. Verify version-specific length before use.",
    "MSP89": "4B: U16LE channelEncoding=(band-1)*8+(channel-1),orMHz when no band/channel; U8powerIndex; U8pit. Original queues250save then88readback. No lowPowerDisarm field written.",
    "MSP137": "Request{bandIndex}; responseU8bandID,length-prefixedname,fixed1Bletter,U8factory,U8channelCount,channelCount*U16LEMHz. Recovered source omitted factory byte.",
    "MSP138": "Request{powerIndex}; responseU8index,U16LEpowerValue,length-prefixedlabel. Label may be nonnumeric.",
    "MSP164": "U8count,thenrecords U8type,U8id,U8quality,U8signal;type255ends;status=quality&7,used=(quality&8)>>3. Existence/scheduling verified; data agent owns data-view requirements.",
    "nativeTBSread": "CRSF0x10: data1sourceECpreferredorCEreceiver,data2powerDbm,data3/4frequencyBE,data5bit0PIT. No explicit acknowledgement protocol observed.",
    "nativeTBSfreq": "CRSF0x32:{CE,EA,08,02,freqHi,freqLo}",
    "nativeTBSpower": "CRSF0x32:{CE,EA,08,08,powerDbm};zeroPITON. CorrectOFF/restoration semantics require independent implementation and hardware verification."
  },
